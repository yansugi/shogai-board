[Unit]
Description=障害情報ボード (ShogaiBoard)
After=network.target

[Service]
# publishフォルダの中身一式を配置した先のパスに合わせて変更する
WorkingDirectory=/var/www/shogai-board
ExecStart=/usr/bin/dotnet /var/www/shogai-board/ShogaiBoard.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=shogai-board

# アプリ専用の実行ユーザー（README参照）。root等では実行しないこと
User=shogai-board
Group=shogai-board

Environment=ASPNETCORE_ENVIRONMENT=Production
# Nginx等のリバースプロキシからのみアクセスさせるため、127.0.0.1にバインドする
Environment=ASPNETCORE_URLS=http://127.0.0.1:5243

[Install]
WantedBy=multi-user.target
