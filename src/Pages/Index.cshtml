@section Scripts {
    <script>
        // 対応状況の更新を反映するため、1分ごとに自動リロードする。
        setTimeout(() => location.reload(), 60000);

        // 対象システム管理画面で「よく使う」にチェックされたシステムの編集・削除ボタンのみ表示する
        // （チェックが1件もない場合は絞り込まず、どのシステムの編集・削除ボタンも表示したままにする）。
        (function filterEditAndDeleteButtons() {
            const favoriteIds = ShogaiBoardForms.getFavoriteSystemIds();
            if (favoriteIds.length === 0) {
                return;
            }
            document.querySelectorAll(".edit-incident-link, .edit-maintenance-link, form[data-system-id]").forEach(function (el) {
                const systemId = parseInt(el.dataset.systemId, 10);
                if (!favoriteIds.includes(systemId)) {
                    el.remove();
                }
            });
        })();
    </script>
}
