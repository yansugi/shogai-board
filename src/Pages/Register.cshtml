@page "{id:int?}"
@model RegisterModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "障害編集" : "障害登録";
}

<link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" />

<div class="mb-4">
    <h1 class="h3 mb-1 fw-bold">@(isEdit ? "障害編集" : "障害登録")</h1>
    <p class="page-subtitle mb-0">対象システム・障害内容・発生日時等を選択して@(isEdit ? "内容を更新してください。" : "登録してください。")</p>
</div>

<div class="card page-card" style="max-width: 680px;">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label">対象システム</label>
                <div class="system-combobox">
                    <input type="text" id="systemSearchInput" class="form-control form-control-lg" placeholder="システム名で検索..." autocomplete="off" />
                    <input type="hidden" asp-for="SystemId" />
                    <div id="systemOptionsList" class="system-options-list"></div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">障害内容</label>
                <textarea asp-for="Description" class="form-control form-control-lg" rows="3" placeholder="例：住民票のオンライン交付が利用できない状態です。"></textarea>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label">重要度</label>
                    <select asp-for="Severity" class="form-select form-select-lg">
                        <option value="@IncidentSeverity.Critical">@IncidentSeverity.Critical.ToLabel()</option>
                        <option value="@IncidentSeverity.Major">@IncidentSeverity.Major.ToLabel()</option>
                        <option value="@IncidentSeverity.Minor">@IncidentSeverity.Minor.ToLabel()</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">対応状況</label>
                    <select asp-for="Status" id="statusSelect" class="form-select form-select-lg">
                        <option value="@IncidentStatus.Investigating">@IncidentStatus.Investigating.ToLabel()</option>
                        <option value="@IncidentStatus.InProgress">@IncidentStatus.InProgress.ToLabel()</option>
                        <option value="@IncidentStatus.Resolved">@IncidentStatus.Resolved.ToLabel()</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">影響範囲・対象業務（任意）</label>
                <input asp-for="AffectedScope" class="form-control form-control-lg" placeholder="例：住民票のコンビニ交付のみ、庁内全体 等" />
            </div>

            <div class="mb-3">
                <label class="form-label">発生日時</label>
                <input asp-for="OccurredAt" type="text" id="occurredAt" class="form-control form-control-lg datetime-input" autocomplete="off" />
            </div>

            <div class="mb-3">
                <label class="form-label">復旧予定時刻（見込み・任意）</label>
                <input asp-for="EstimatedRecoveryAt" type="text" id="estimatedRecoveryAt" class="form-control form-control-lg datetime-input" autocomplete="off" />
            </div>

            <div class="mb-3" id="resolvedAtGroup">
                <label class="form-label">復旧日時（実績）</label>
                <input asp-for="ResolvedAt" type="text" id="resolvedAt" class="form-control form-control-lg datetime-input" autocomplete="off" />
                <p class="form-text mb-0">対応状況を「復旧済み」にして未入力のまま保存すると、自動的に現在時刻が設定されます。</p>
            </div>

            <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">@(isEdit ? "更新する" : "登録する")</button>
            <a asp-page="/Index" class="btn btn-outline-secondary rounded-pill px-4">戻る</a>
        </form>
    </div>
</div>

<script id="systemOptionsData" type="application/json">@Html.Raw(Model.SystemOptionsJson)</script>

@section Scripts {
    <script src="~/lib/flatpickr/flatpickr.min.js"></script>
    <script src="~/lib/flatpickr/l10n/ja.js"></script>
    <script>
        flatpickr.localize(flatpickr.l10ns.ja);

        // 対象システム選択欄：全システムを対象に検索しながら選べるコンボボックスにする。
        let systemOptions = [];
        try {
            systemOptions = JSON.parse(document.getElementById("systemOptionsData").textContent || "[]");
        } catch {
            systemOptions = [];
        }
        ShogaiBoardForms.setupSystemCombobox("systemSearchInput", "SystemId", "systemOptionsList", systemOptions);

        // 発生日時・復旧予定時刻・復旧日時は、いずれも日付＋時刻を1つの欄で入力できるようにする。
        ShogaiBoardForms.setupDateTimePicker("occurredAt");
        ShogaiBoardForms.setupDateTimePicker("estimatedRecoveryAt");
        const resolvedAtPicker = ShogaiBoardForms.setupDateTimePicker("resolvedAt");

        // 対応状況が「復旧済み」以外の間は、復旧日時（実績）の入力欄を表示しない（未復旧のため）。
        // 「復旧済み」に切り替えた瞬間、復旧日時が未入力なら現在時刻を自動入力する
        // （保存時に未入力なら現在時刻が設定されるのはサーバー側でも行っているが、画面上でも分かるようにする）。
        // 既に値が入っている場合（編集時など）は上書きしない。
        const statusSelect = document.getElementById("statusSelect");
        const resolvedAtGroup = document.getElementById("resolvedAtGroup");
        function syncResolvedAtField() {
            const isResolved = statusSelect.value === "@IncidentStatus.Resolved";
            resolvedAtGroup.classList.toggle("d-none", !isResolved);
            if (isResolved && !resolvedAtPicker.input.value) {
                resolvedAtPicker.setDate(new Date(), true);
            }
        }
        statusSelect.addEventListener("change", syncResolvedAtField);
        syncResolvedAtField();
    </script>
}
